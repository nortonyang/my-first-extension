{
  "manifest_version": 3,
  "name": "我的第一个Chrome插件",
  "description": "这是一个简单的Chrome插件示例",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
        "16": "images/icon16.svg",
        "48": "images/icon48.svg",
        "128": "images/icon128.svg"
      }
  },
  "permissions": ["activeTab", "storage", "contextMenus", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}